<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>BodyDragging</RootNamespace>
    <AssemblyName>BodyDragging</AssemblyName>
    <Authors>kobethuy</Authors>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SptRoot Condition="'$(SptRoot)' == ''">F:\SPT_4.1</SptRoot>
  </PropertyGroup>
  
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath></Reference>
    <Reference Include="Comfort"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath></Reference>
    <Reference Include="spt-common"><HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath></Reference>
  </ItemGroup>
  
  <PropertyGroup>
    <InstallDir>$(SptRoot)\BepInEx\plugins\kobethuy-BodyDragging</InstallDir>
    <LicenseFile>$(MSBuildProjectDirectory)\..\LICENSE</LicenseFile>
    <NoticeFile>$(MSBuildProjectDirectory)\..\NOTICE</NoticeFile>
    <PackageRoot>$(MSBuildProjectDirectory)\..\dist\BodyDragging-$(Version)</PackageRoot>
    <PackageZip>$(MSBuildProjectDirectory)\..\dist\BodyDragging-$(Version).zip</PackageZip>
  </PropertyGroup>

  <!-- copies main DLL + (if present) the Fika bridge DLL from the sibling project's own
       output, so a single build drops both into one plugin folder -->
  <Target Name="DeployClient" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(InstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(InstallDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <FikaBridgeDll Include="$(MSBuildProjectDirectory)\..\BodyDragFika\bin\$(Configuration)\netstandard2.1\BodyDragFika.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FikaBridgeDll)" DestinationFolder="$(InstallDir)" SkipUnchangedFiles="false" Condition="Exists('%(FikaBridgeDll.Identity)')" />
  </Target>

  <Target Name="CreateReleasePackage" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(Configuration)' == 'Release' and '$(SkipPackage)' != 'true'">
    <RemoveDir Directories="$(PackageRoot)" />
    <Delete Files="$(PackageZip)" />
    <MakeDir Directories="$(PackageRoot)\BepInEx\plugins\kobethuy-BodyDragging" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\kobethuy-BodyDragging" />
    <Copy SourceFiles="$(LicenseFile)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\kobethuy-BodyDragging" />
    <Copy SourceFiles="$(NoticeFile)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\kobethuy-BodyDragging" Condition="Exists('$(NoticeFile)')" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="BodyDragging release package created: $(PackageZip)" />
  </Target>

</Project>
